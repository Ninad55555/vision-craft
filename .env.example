# VisionCraft - environment configuration
# Copy to .env and fill in. NEVER commit the real .env.

# --- Hugging Face / OpenAI-compatible provider ---
# Fine-grained token with "Make calls to Inference Providers" permission.
HF_TOKEN=
HF_BASE_URL=https://router.huggingface.co/v1

# Primary model. M0 (2026-10-01) confirmed live on the router:
#   Qwen/Qwen3-VL-235B-A22B-Instruct   <- largest Qwen VL served (chosen default)
#   Qwen/Qwen2.5-VL-72B-Instruct       <- proven fallback
#   Qwen/Qwen3-VL-30B-A3B-Instruct     <- fast/cheap fallback
# NOT available: Qwen/Qwen3-VL-8B-Instruct (was in earlier drafts; does not exist).
# Run `python scripts/list_models.py` to re-check what is live today.
HF_MODEL_ID=Qwen/Qwen3-VL-235B-A22B-Instruct
HF_FALLBACK_MODEL_IDS=Qwen/Qwen2.5-VL-72B-Instruct,Qwen/Qwen3-VL-30B-A3B-Instruct

# --- Generation limits ---
MAX_OUTPUT_TOKENS=8192
TEMPERATURE=0.2
REQUEST_TIMEOUT_SECONDS=300
MAX_RETRIES=2

# --- Image handling ---
IMAGE_MAX_SIDE=1600
MAX_UPLOAD_MB=10
MAX_IMAGE_PAYLOAD_KB=3000

# --- Server ---
APP_HOST=127.0.0.1
APP_PORT=8000
CORS_ORIGINS=http://127.0.0.1:8000,http://localhost:8000
APP_ACCESS_KEY=
RATE_LIMIT_PER_MINUTE=6
LOG_LEVEL=INFO

# --- P1 (disabled in v1.0) ---
ENABLE_REFINE_LOOP=false
REFINE_MAX_ITERATIONS=2
